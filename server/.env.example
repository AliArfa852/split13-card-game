# Copy to .env and adjust. Defaults shown are what the code falls back to.

# Port the server listens on. Render sets this automatically in production.
PORT=8000

# Comma separated list of origins allowed to connect.
CORS_ORIGIN=http://localhost:3000,https://split-13.vercel.app

# --- Game configuration ---
# Split 13 is a fixed 4-seat, 2-team, 13-cards-each game — there is no
# player-count or hand-size setting to configure.

# How long a player has to throw a card before their turn auto-resolves
# (a random card from their hand is thrown for them).
TURN_TIMER_MS=20000

# How long a bot "thinks" before it throws, randomized between the two on
# every turn so bots don't all move on the same metronome click.
BOT_THINK_MIN_MS=2000
BOT_THINK_MAX_MS=7000

# --- Socket.IO keepalive, both in milliseconds ---

# How often the server pings each client.
SOCKET_PING_INTERVAL_MS=10000

# How long a client has to answer a ping before it's considered disconnected.
SOCKET_PING_TIMEOUT_MS=8000
